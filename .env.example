ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8080
# Device SSH settings, separate from the web administrator account.
# Set the host and user, then place the key and verified host keys in ./secrets.
LTE_HOST=
LTE_PORT=22
LTE_USERNAME=
LTE_KEY_FILE=/run/secrets/lte_key
LTE_KNOWN_HOSTS=/run/secrets/known_hosts
LTE_DEVICE=/dev/ttyUSB2
LTE_STORAGE=SM
POLL_INTERVAL=60
# Enable both only behind a trusted HTTPS reverse proxy.
REQUIRE_HTTPS=0
TRUST_PROXY=0
CSRF_TRUSTED_ORIGINS=

# Optional SMS forwarding. Leave every SMTP_* variable absent to configure it in Settings.
# Defining any variable below (even empty or SMTP_ENABLED=0) locks the entire SMTP form.
# SMTP_ENABLED=1
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=relay-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=sms@example.com
# SMTP_TO=reader@example.com
